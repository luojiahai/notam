{
	"name": "notam",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"module": "src/cli/index.ts",
	"bin": {
		"notam": "src/cli/index.ts"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"scripts": {
		"test": "bun run test:server && bun run test:web && bun run test:install",
		"test:server": "bun test tests/shared tests/store tests/jobs tests/core tests/server tests/cli tests/scripts tests/integration",
		"test:web": "bun test --preload ./tests/web/happy-dom.ts tests/web",
		"test:install": "bun test tests/install",
		"test:binary": "bun test tests/binary",
		"test:e2e": "bunx playwright test",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"build:web": "bunx vite build --config web/vite.config.ts",
		"build:binary": "bun run scripts/build-binary.ts",
		"build:binaries": "bun run scripts/build-binary.ts --all",
		"checksums": "bun run scripts/checksums.ts --dir dist",
		"dev:web": "bunx vite --config web/vite.config.ts",
		"start": "bun run src/cli/index.ts"
	},
	"dependencies": {
		"@tanstack/react-query": "^5",
		"hono": "^4",
		"lucide-react": "^1.33.0",
		"react": "^19",
		"react-dom": "^19",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@happy-dom/global-registrator": "^19",
		"@playwright/test": "^1",
		"@testing-library/dom": "^10",
		"@testing-library/react": "^16",
		"@testing-library/user-event": "^14",
		"@types/bun": "^1.4.0",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^5",
		"typescript": "^7.0.2",
		"vite": "^7"
	}
}
